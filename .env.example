# ====== Site ======
NEXT_PUBLIC_SITE_URL=https://www.vfr-gmbh.de
NEXT_PUBLIC_COMPANY_NAME="Verkehrsfachschule Rheinland GmbH"

# ====== Chatbot (Anthropic) ======
# Key unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# ====== Flario (Kursverwaltung) ======
# Trag hier den API-Endpoint und Key ein, sobald von Flario zur Verfügung gestellt
FLARIO_API_BASE=https://api.flario.example.com
FLARIO_API_KEY=
# Optional: account/tenant id
FLARIO_TENANT_ID=

# ====== Stripe (Zahlung: PayPal + Kreditkarte + SEPA) ======
# Aus deinem Stripe-Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Aus Stripe Dashboard -> Developers -> Webhooks (Endpoint anlegen für /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# ====== E-Mail (Resend für Rechnungs- und Rückruf-Mails) ======
# Resend: https://resend.com — Domain verifizieren, dann API-Key generieren
RESEND_API_KEY=re_...
MAIL_FROM="VFR Buchung <buchung@vfr-gmbh.de>"
MAIL_REPLY_TO=info@vfr-gmbh.de
MAIL_BCC_INTERNAL=info@vfr-gmbh.de

# ====== Rechnungen ======
# Pfad relativ zum Projekt — hier werden generierte PDFs archiviert
INVOICE_ARCHIVE_DIR=./invoices
# Rechnungsnummer-Prefix und Startwert
INVOICE_PREFIX=VFR-
INVOICE_START_NUMBER=10001
# Steuersatz für Bildungsleistungen (i.d.R. steuerfrei §4 Nr.21 UStG, sonst 19)
INVOICE_VAT_RATE=0
INVOICE_VAT_NOTE="Umsatzsteuerfrei gemäß §4 Nr. 21 a) bb) UStG"

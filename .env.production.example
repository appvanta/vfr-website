# VFR Website — Produktions-Environment
#
# Diese Datei NICHT in Git committen. Auf dem Server wird sie als .env.production
# abgelegt (in /opt/vfr-website/.env.production) und von docker-compose gelesen.
#
# Nach Änderungen: docker compose up -d (Container wird neu gestartet)

# ========== Site ==========
NEXT_PUBLIC_SITE_URL=https://fahrlehrer-portal.de
NEXT_PUBLIC_COMPANY_NAME="Verkehrsfachschule Rheinland GmbH"

# ========== Datenbank (eigene Postgres, läuft im docker-compose) ==========
# Frei wählbares starkes Passwort (min. 24 Zeichen). Einmal vergeben, danach nie mehr ändern
# ohne Backup/Restore.
POSTGRES_PASSWORD=
# Der App-Code baut die Connection-URL aus diesen Werten selbst, Container-Name reicht.
DATABASE_URL=postgres://vfr:${POSTGRES_PASSWORD}@vfr_postgres:5432/vfr

# ========== Chatbot (Anthropic) ==========
# Key unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# ========== Flario (Kursverwaltung) ==========
FLARIO_API_BASE=https://api.flario.example.com
FLARIO_API_KEY=
FLARIO_TENANT_ID=
# Webhook-Secret zum Verifizieren von Flario→VFR-Callbacks
FLARIO_WEBHOOK_SECRET=

# ========== Stripe (Zahlungen) ==========
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ========== E-Mail (Resend) ==========
RESEND_API_KEY=re_...
MAIL_FROM="VFR Buchung <buchung@vfr-gmbh.de>"
MAIL_REPLY_TO=info@vfr-gmbh.de
MAIL_BCC_INTERNAL=info@vfr-gmbh.de
MAIL_CC_BUERO=info@vfr-gmbh.de

# ========== Rechnungen ==========
INVOICE_ARCHIVE_DIR=/app/invoices
INVOICE_PREFIX=VFR-
INVOICE_START_NUMBER=10001
INVOICE_VAT_RATE=0
INVOICE_VAT_NOTE="Umsatzsteuerfrei gemäß §4 Nr. 21 a) bb) UStG"

# ========== Admin-Bereich ==========
# Basic-Auth für /admin — Format: "user:passwort"
ADMIN_BASIC_AUTH=admin:

# ========== Tokens ==========
# Für Double-Opt-In-Links und ähnliche signierte Tokens (min. 32 Zeichen zufällig)
REGISTRATION_TOKEN_SECRET=
